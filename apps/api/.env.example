# apps/api environment. Copy to apps/api/.env.local (gitignored) and fill in.
# Real values are NEVER committed. On Railway these are set as service variables.

# --- Server ---
# Injected by Railway. Locally defaults to 4000 when unset.
PORT=
# CORS lock for the browser-callable connect surface (R7/R9 deploy). Set to
# the deployed dashboard origin once known, e.g.
# https://usemount-web-production.up.railway.app (comma-separated for several).
# Unset → permissive, which is fine for local dev + the first deploy.
WEB_ORIGIN=

# --- Build worker (deploy) ---
# Where cloned customers' node_modules cache lives. The default
# (/var/lib/usemount/node-modules-cache) is NOT writable on Railway — set this
# to a writable path such as /tmp/usemount-node-modules-cache (ephemeral; a
# persistent volume can replace it later). The container also needs the package
# manager the customer's repo uses (pnpm/yarn/bun) on PATH — `corepack enable`
# in the Railway build covers pnpm/yarn.
# NODE_MODULES_CACHE=/tmp/usemount-node-modules-cache
# Optional reconciler tuning / kill switches (see migration-plan.md PR10).
# DISABLE_BUILD_WORKER=
# DISABLE_RECONCILER=
# RECONCILER_INTERVAL_MS=
# RECONCILER_FIRST_DELAY_MS=

# --- Supabase (server-side, privileged) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub App (usemount.dev) ---
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# PEM private key, base64-encoded to a single line. Decoded at runtime.
GITHUB_APP_PRIVATE_KEY_BASE64=
# Optional. Public GitHub App slug for the install redirect URL.
# Defaults to "usemount-dev" (the registered app) when unset.
# GITHUB_APP_SLUG=usemount-dev
